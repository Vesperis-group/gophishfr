[Unit]
Description=GophishFR
After=network.target
[Service]
Type=simple
WorkingDirectory=/home/{{ gophish_user }}/gophish_deploy/
ExecStart="/home/{{ gophish_user }}/gophish_deploy/gophishfr"
User={{ gophish_user }}
PIDFile="/home/{{ gophish_user }}/gophish_deploy/gophishfr.pid"
{% if gophish_initial_admin_password | length > 0 %}
Environment="GOPHISH_INITIAL_ADMIN_PASSWORD_FILE=/home/{{ gophish_user }}/gophish_deploy/.initial-admin-password"
{% endif %}
[Install]
WantedBy=multi-user.target
